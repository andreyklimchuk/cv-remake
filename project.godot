; Engine configuration file.
; RE: Code Veronica X — prison (Godot port of the cvx-prison web build)

config_version=5

[application]

config/name="CVX Prison (Godot)"
config/description="Fan port of RE: Code Veronica X (PS3 data) — prison section"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

Assets="*res://scripts/assets.gd"
Text="*res://scripts/text.gd"

[display]

window/size/viewport_width=1024
window/size/viewport_height=768
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[editor_plugins]

enabled=PackedStringArray()

[filesystem]

import/blender/enabled=false
import/fbx/enabled=false

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

common/physics_ticks_per_second=30

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0, 0, 0, 1)

[shader_globals]

amb_rom={
"type": "vec3",
"value": Vector3(1, 1, 1)
}
amb_chr={
"type": "vec3",
"value": Vector3(1, 1, 1)
}
amb_obj={
"type": "vec3",
"value": Vector3(1, 1, 1)
}
amb_itm={
"type": "vec3",
"value": Vector3(1, 1, 1)
}
pl_pos0={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
pl_pos1={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
pl_pos2={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
pl_col0={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
pl_col1={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
pl_col2={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
pl_rng0={
"type": "vec2",
"value": Vector2(0, 1)
}
pl_rng1={
"type": "vec2",
"value": Vector2(0, 1)
}
pl_rng2={
"type": "vec2",
"value": Vector2(0, 1)
}
dl_dir={
"type": "vec3",
"value": Vector3(0, -1, 0)
}
dl_col={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
